<?xml version="1.0"?>
<robot name="velmobil" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">
  
  <xacro:arg name="floating" default="true"/>

  <xacro:include filename="$(find velmobil_description)/urdf/properties.urdf.xacro" />
  <xacro:include filename="$(find velmobil_description)/urdf/macros.urdf.xacro" />

  <link name="base_footprint" />
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="file://$(find velmobil_description)/models/base.dae" />
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 -0.011 0.001" rpy="0 0 0"/>
      <geometry>
        <box size="${base_link_width} ${base_link_height} ${base_link_depth}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.13" ixy="0.0" ixz="0.0" iyy="0.42" iyz="0.0" izz="0.48"/>
    </inertial>
  </link>
  <link name="front_link">
      <visual>
          <geometry>
              <mesh filename="file://$(find velmobil_description)/models/front.dae"/>
          </geometry>
          <material name="orange"/>
      </visual>
      <collision>
          <origin xyz="0.0 0.003 0.002" rpy="0.0 0.0 1.57"/>
          <geometry>
              <box size="0.6736 0.1906 0.1600"/>
          </geometry>
      </collision>
      <inertial>
          <mass value="${front_mass}"/>
          <inertia ixx="0.7351" ixy="0.0" ixz="0.0" iyy="0.0771" iyz="0.0" izz="0.7483"/>
      </inertial>
  </link>
  <joint name="footprint_joint" type="fixed">
      <origin xyz="${base_center_offset} 0 ${base_link_center_offset + 0.03}" rpy="0 0 0"/>
      <parent link="base_footprint"/>
      <child link="base_link"/>
  </joint>
  <joint name="front_joint" type="fixed">
      <origin xyz="${front_base_offset} 0 0" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="front_link"/>
  </joint>

  <xacro:wheel prefix="front_left" x="${front_base_offset}" y="${wheel_y_offset}"/>
  <xacro:wheel prefix="front_right" x="${front_base_offset}" y="${-wheel_y_offset}"/>
  <xacro:wheel prefix="rear_left" x="${wheel_r_base_x_offset}" y="${wheel_y_offset}"/>
  <xacro:wheel prefix="rear_right" x="${wheel_r_base_x_offset}" y="${-wheel_y_offset}"/>


  <xacro:wheel_friction prefix="front_left" dir="1"/>
  <xacro:wheel_friction prefix="front_right" dir="-1"/>
  <xacro:wheel_friction prefix="rear_left" dir="-1"/>
  <xacro:wheel_friction prefix="rear_right" dir="1"/>


  <xacro:lidar name="left" side="1" yaw="0.0" />
  <xacro:lidar name="right" side="-1" yaw="-3.141592" />

  <xacro:imu />

  <link name="camera_link">
    <collision>
        <origin xyz="${-base_center_offset} 0 0" rpy="0 0 1.57"/>
        <geometry>
            <box size="0.1 0.2 0.2"/>
        </geometry>
    </collision>
    <visual>
        <origin xyz="${-base_center_offset} 0 0" rpy="0 0 1.57"/>
        <geometry>
            <box size="0.2 0.38 0.3"/>
        </geometry>
        <material name="orange"/>
    </visual>
    <inertial>
        <mass value="5.0"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0"
                 iyy="0.1" iyz="0.0" izz="0.1"/>
    </inertial>
  </link>

  <joint name="base_camera_link" type="fixed">
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="camera_link"/>
  </joint>

  <xacro:front_real_sense />
  <xacro:back_real_sense />


  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:joint_interface name="front_left_wheel_joint"/>
    <xacro:joint_interface name="front_right_wheel_joint"/>
    <xacro:joint_interface name="rear_left_wheel_joint"/>
    <xacro:joint_interface name="rear_right_wheel_joint"/>
  </ros2_control>




  <xacro:if value="$(arg floating)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find velmobil_description)/control_config/floating_velmobil.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
  <xacro:unless value="$(arg floating)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find velmobil_description)/control_config/velmobil.yaml</parameters>
        <ros>
          <remapping>/mecanum_drive_controller/reference:=/cmd_vel</remapping>
          <remapping>/mecanum_drive_controller/odom:=/odom</remapping>
        </ros>
      </plugin>
    </gazebo>
  </xacro:unless>



</robot>