<?xml version="1.0"?>
<robot name="simple_velmobil" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

  <xacro:include filename="$(find velmobil_description)/urdf/properties.urdf.xacro" />
  <xacro:include filename="$(find velmobil_description)/urdf/macros.urdf.xacro" />


  <link name="base_footprint" />
  <link name="base_link">
    <collision>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <geometry><box size="0.1 0.1 0.1"/></geometry>  <!-- mock colision -->
    </collision>
    <visual>
      <geometry>
        <mesh filename="file://$(find velmobil_description)/models/base.dae" />
      </geometry>
    </visual>
    <inertial>
      <origin xyz="0 0 0.5" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.13" ixy="0.0" ixz="0.0" iyy="0.42" iyz="0.0" izz="0.48"/>
    </inertial>
  </link>
  <joint name="footprint_joint" type="fixed">
      <origin xyz="0 0 ${wheel_radius + wheel_base_offset}" rpy="0 0 0"/>
      <parent link="base_footprint"/>
      <child link="base_link"/>
  </joint>

  <xacro:wheel prefix="front_left" x="0.5" y="${wheel_y_offset}"/>
  <xacro:wheel prefix="front_right" x="0.5" y="${-wheel_y_offset}"/>
  <xacro:wheel prefix="rear_left" x="-0.5" y="${wheel_y_offset}"/>
  <xacro:wheel prefix="rear_right" x="-0.5" y="${-wheel_y_offset}"/>


  <xacro:wheel_friction prefix="front_left" dir="1"/>
  <xacro:wheel_friction prefix="front_right" dir="-1"/>
  <xacro:wheel_friction prefix="rear_left" dir="-1"/>
  <xacro:wheel_friction prefix="rear_right" dir="1"/>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:joint_interface name="front_left_wheel_joint"/>
    <xacro:joint_interface name="front_right_wheel_joint"/>
    <xacro:joint_interface name="rear_left_wheel_joint"/>
    <xacro:joint_interface name="rear_right_wheel_joint"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find velmobil_description)/control/simple_velmobil.yaml</parameters>
      <ros>
        <remapping>/mecanum_drive_controller/reference:=/cmd_vel</remapping>
        <remapping>/mecanum_drive_controller/odom:=/odom</remapping>
      </ros>
    </plugin>
  </gazebo>
</robot>