<?xml version="1.0"?>
<robot name="simple_velmobil" xmlns:xacro="http://www.ros.org/wiki/xacro" xmlns:gz="http://gazebosim.org/schema">

    <xacro:macro name="wheel" params="prefix x y">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <origin xyz="${x} ${y} 0.3" rpy="-${pi/2} 0 0"/>
            <parent link="base_link"/>
            <child link="${prefix}_wheel"/>
            <axis xyz="0 0 1"/>
            <dynamics damping="0.2"/>
        </joint>
        <link name="${prefix}_wheel">
            <collision><geometry><sphere radius="0.3"/></geometry></collision>
            <visual><geometry><sphere radius="0.3"/></geometry><material name="black"/></visual>
            <inertial>
                <mass value="2"/>
                <inertia ixx="0.145" ixy="0.0" ixz="0.0" iyy="0.145" iyz="0.0" izz="0.125"/>
            </inertial>
        </link>
    </xacro:macro>

    <xacro:macro name="wheel_friction" params="prefix dir">
        <gazebo reference="${prefix}_wheel">
            <collision>
                <surface>
                <friction>
                    <ode>
                        <mu1>1.0</mu1><mu2>1.0</mu2>
                        <kp>1000000.0</kp><kd>10.0</kd><minDepth>0.001</minDepth>
                        <fdir1 gz:expressed_in="base_link">1 ${dir} 0</fdir1>
                    </ode>
                </friction>
                </surface>
            </collision>
        </gazebo>
    </xacro:macro>

    <xacro:macro name="joint_interface" params="name">
        <joint name="${name}">
            <command_interface name="velocity">
                <param name="min">-1</param>
                <param name="max">1</param>
            </command_interface>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
    </xacro:macro>



</robot>