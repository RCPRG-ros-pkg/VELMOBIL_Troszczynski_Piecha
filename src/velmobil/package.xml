<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>velmobil</name>
  <version>0.0.0</version>
  <description>Engineer Project Simulation</description>
  <maintainer email="troszczynskikamil@outlook.com">kamil</maintainer>
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <build_depend>geometry_msgs</build_depend>
  <build_depend>pluginlib</build_depend>
  <build_depend>rclpy</build_depend>
  <build_depend>rclpy_action</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>ros_gz_bridge</build_depend>
  <build_depend>ros_gz_sim</build_depend>

  <exec_depend>ament_index_python</exec_depend>
